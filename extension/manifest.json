{
    "manifest_version": 3,
    "name": "Fake Review Detector",
    "version": "1.0",
    "description": "Detects fake reviews on Amazon and Flipkart using AI",
    "permissions": [
      "activeTab",
      "scripting",
      "tabs"
    ],
    "host_permissions": [
      "https://*.amazon.in/*",
      "https://*.amazon.com/*",
      "https://*.flipkart.com/*"
    ],
    "content_security_policy": {
      "extension_pages": "script-src 'self'; object-src 'self'"
    },
    "action": {
      "default_popup": "popup.html",
      "default_icon": {
        "16": "icon.png",
        "48": "icon.png",
        "128": "icon.png"
      }
    },
    "content_scripts": [
      {
        "matches": [
          "https://*.amazon.in/*",
          "https://*.amazon.com/*",
          "https://*.flipkart.com/*"
        ],
        "js": ["content.js"],
        "run_at": "document_idle"
      }
    ]
  }